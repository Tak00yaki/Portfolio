# Copy this file to secrets.toml (same folder) and fill in real values.
# secrets.toml is gitignored - never commit real keys.

TMDB_API_KEY = "your-tmdb-api-key"
SPOTIFY_CLIENT_ID = "your-spotify-client-id"
SPOTIFY_CLIENT_SECRET = "your-spotify-client-secret"

# Optional: unlocks owner mode (Favourites / Watchlist, "Open in Spotify").
OWNER_PASSCODE = "choose-a-passcode"
